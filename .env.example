APP_NAME=rewear.id
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (Supabase PostgreSQL) ───
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rewear_id
DB_USERNAME=postgres
DB_PASSWORD=

# ─── Supabase Direct Connection (optional) ───
# DB_HOST=db.xxxxxxxxxxxx.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=your-supabase-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@rewear.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=rewear-id
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Sanctum ───
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

# ─── Midtrans ───
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_3DS=true
MIDTRANS_PAYMENT_EXPIRY=1440

# ─── RajaOngkir ───
RAJAONGKIR_API_KEY=
RAJAONGKIR_ACCOUNT_TYPE=starter
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com/starter
RAJAONGKIR_CACHE_TTL=86400

# ─── Escrow ───
ESCROW_AUTO_COMPLETE_HOURS=48
ESCROW_SERVICE_FEE_PERCENTAGE=5.0
ESCROW_MINIMUM_SERVICE_FEE=1000
ESCROW_SHIPPING_DEADLINE_HOURS=72

# ─── Withdrawal ───
WITHDRAWAL_MINIMUM_AMOUNT=10000
WITHDRAWAL_FEE=0
WITHDRAWAL_PROCESSING_DAYS=1
